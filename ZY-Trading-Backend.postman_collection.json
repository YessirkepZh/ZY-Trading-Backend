{
  "info": {
    "name": "ZY Trading Backend",
    "description": "Local API collection for ZY Trading Backend (http://localhost:3001).\n\nIncludes screenshot upload to Cloudflare R2:\n- createNote: optional `screenshot` (base64 PNG) → saved as setup\n- updateDeal: optional `screenshot` on entered/closed → saved as entry/close\n- uploadScreenshot: standalone upload endpoint\n\nBody limit: 10MB (base64 screenshots).",
    "_postman_id": "zy-trading-backend-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "dealId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "screenshotBase64",
      "value": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
      "type": "string",
      "description": "Minimal 1x1 PNG for testing screenshot upload (replace with real chart screenshot from Extension)"
    },
    {
      "key": "lastScreenshotUrl",
      "value": "",
      "type": "string",
      "description": "Set automatically after successful uploadScreenshot request"
    }
  ],
