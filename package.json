{
  "name": "zy-trading-backend",
  "version": "1.0.0",
  "description": "ZY Trading Backend — personal trader system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "migrate": "node dist/db/migrate.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.726.1",
    "@fastify/cors": "^11.2.0",
    "axios": "^1.16.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "node-telegram-bot-api": "^0.67.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
