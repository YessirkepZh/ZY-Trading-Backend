PORT=3001
NODE_ENV=production
# Comma-separated origins, e.g. https://app.example.com,chrome-extension://abcdef
# Omit or leave empty to allow any origin (reflect request Origin)
CORS_ORIGINS=
# Legacy shared key (header x-api-key), acts as the owner account. Empty = disabled
API_KEY=
# Secret for signing access tokens, e.g. `openssl rand -hex 32`. Required in production
JWT_SECRET=
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to false for local dev so polling does not conflict with production bot
BOT_ENABLED=true
TELEGRAM_TOKEN=
ALLOWED_USERS=123456789
# POLYGON_API_KEY=deprecated_use_twelve_data_instead
# TWELVE_DATA_API_KEY recommended for up-to-date stock prices (falls back to Polygon if unset)
TWELVE_DATA_API_KEY=
CRYPTOCOMPARE_API_KEY=
ANTHROPIC_API_KEY=
RISK_CRYPTO_DEFAULT=15
LUFT_PERCENT=20
RATIO=3
RISK_SUM=15
